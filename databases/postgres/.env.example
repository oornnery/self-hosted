# --- PostgreSQL (obrigatório para LiteLLM) ---
POSTGRES_USER=litellm_user                    # Usuário do banco (altere se quiser)
POSTGRES_PASSWORD=litellm_password            # Senha do banco (altere para algo seguro)
POSTGRES_DB=litellm_db                        # Nome do banco
DATABASE_URL=postgresql://litellm_user:litellm_password@postgres:5432/litellm_db?sslmode=disable