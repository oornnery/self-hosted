# Bridge images
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:latest
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest

# Bridge container names
POSTGRES_EXPORTER_CONTAINER_NAME=postgres-exporter
OTEL_COLLECTOR_CONTAINER_NAME=otel-bridge
FORWARD_CONTAINERS=postgres litellm-proxy ollama site homarr headscale traefik crowdsec pihole unbound librechat-api librechat-rag-api

# SigNoz core and network shared with litellm
SIGNOZ_NETWORK=signoz-net
SIGNOZ_OTLP_GRPC_ENDPOINT=signoz-otel-collector:4317
SIGNOZ_UI_PORT=8080
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_PORT=4318
VERSION=v0.114.1
OTELCOL_TAG=v0.144.2

# Postgres exporter connection (Docker service name: postgres)
DATA_SOURCE_URI=postgres:5432/postgres?sslmode=disable
DATA_SOURCE_USER=master
DATA_SOURCE_PASS=master_db_pass
