SITE_IMAGE=ghcr.io/oornnery/site:latest
SITE_CONTAINER_NAME=site
SITE_PORT=8001

SITE_APP_DEBUG=false
SITE_LOG_LEVEL=INFO
SITE_NAME=Fabio Souza
SITE_BASE_URL=https://site.localhost:8443
SITE_TRUSTED_HOSTS=site.localhost,localhost,127.0.0.1
SITE_CORS_ALLOW_ORIGINS=https://site.localhost:8443,http://localhost:8001

SITE_SECRET_KEY=change-me-with-a-secure-random-secret
SITE_CONTACT_WEBHOOK_URL=

SITE_OTEL_SERVICE_NAME=site-backend
SITE_OTEL_RESOURCE_ATTRIBUTES=service.namespace=site,deployment.environment=production
SITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
SITE_OTEL_EXPORTER_OTLP_INSECURE=true
SITE_OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

SITE_FRONTEND_TELEMETRY_ENABLED=true
SITE_FRONTEND_TELEMETRY_SERVICE_NAME=site-frontend
SITE_FRONTEND_TELEMETRY_SERVICE_NAMESPACE=site
SITE_FRONTEND_TELEMETRY_OTLP_ENDPOINT=
SITE_FRONTEND_TELEMETRY_SAMPLE_RATIO=1.0

SITE_DEFAULT_RATE_LIMIT=60/minute
SITE_RATE_LIMIT=10/minute
SITE_TRUST_FORWARDED_IP_HEADERS=false
SITE_CORS_ALLOW_METHODS=GET,POST,OPTIONS
SITE_CORS_ALLOW_HEADERS=Content-Type,X-Request-ID
SITE_CORS_ALLOW_CREDENTIALS=false
SITE_MAX_REQUEST_BODY_BYTES=1048576
SITE_CONTACT_MAX_BODY_BYTES=65536
